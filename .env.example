# Copy to backend/.env for local development (no Docker), or to .env in the repository root for
# docker compose (which then forces production settings, see docker-compose.yml). Never commit a real .env.

# Database. SQLite works for local development; docker-compose uses PostgreSQL.
DEVPILOT_DATABASE_URL=sqlite:///./devpilot.db
# Where repository snapshots are stored.
DEVPILOT_DATA_DIR=./data
# Fernet key for encrypting GitHub tokens. REQUIRED when DEVPILOT_ENV != development.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DEVPILOT_SECRET_KEY=
DEVPILOT_ENV=development
# Session cookies are sent only over HTTPS when true. REQUIRED (true) when DEVPILOT_ENV != development:
# the app refuses to start otherwise. Browsers accept Secure cookies on http://localhost.
DEVPILOT_COOKIE_SECURE=false
# Strict-Transport-Security max-age in seconds, sent outside development only. 0 = off. Set it
# (e.g. 31536000) only when every request reaches DevPilot over HTTPS.
DEVPILOT_HSTS_SECONDS=0
DEVPILOT_FRONTEND_ORIGIN=http://localhost:5173
# docker compose only: the HTTPS address users open (e.g. https://devpilot.example.com) when a
# reverse proxy on the host serves DevPilot. Leave empty for http://localhost:8080 on the host.
DEVPILOT_PUBLIC_ORIGIN=

# Who may create accounts: open | invite | closed. Leave empty for the default:
# open in development, invite everywhere else. Existing accounts can always sign in.
DEVPILOT_REGISTRATION=
# Required for invite mode; share it only with people you invite. Use a long random value, e.g.
# python -c "import secrets; print(secrets.token_urlsafe(16))". Empty = nobody can register.
# The server operator can always create accounts with: python -m app.cli create-user --email ...
DEVPILOT_INVITE_CODE=

# Local Git import is only allowed beneath these directories (";"-separated). Empty disables it.
DEVPILOT_ALLOWED_LOCAL_ROOTS=

# LLM review and repository Q&A (optional). Without a configured provider, reviews run the static
# analyzers only and the Ask tab says no model is configured. "anthropic" with an empty
# ANTHROPIC_API_KEY counts as not configured.
# anthropic (needs ANTHROPIC_API_KEY, paid) | ollama (local, free; see README) | none
DEVPILOT_LLM_PROVIDER=anthropic
DEVPILOT_LLM_MAX_CONTEXT_CHARS=60000
DEVPILOT_LLM_TIMEOUT_S=120
# Prompt and context versions; defaults chosen by evaluation (docs/phase-3-evaluation.md).
DEVPILOT_LLM_PROMPT_VERSION=v1
DEVPILOT_LLM_CONTEXT=changed

# Anthropic
ANTHROPIC_API_KEY=
DEVPILOT_LLM_MODEL=claude-opus-5-5
DEVPILOT_LLM_EFFORT=medium

# Ollama (https://ollama.com). Keep it on 127.0.0.1; do not expose port 11434 publicly.
DEVPILOT_OLLAMA_URL=http://127.0.0.1:11434
DEVPILOT_OLLAMA_MODEL=qwen2.5-coder:3b
# Context window requested from Ollama. Prompts over ~75% of it are refused rather than truncated.
# 16384 tokens holds roughly 40000 characters of prompt; lower DEVPILOT_LLM_MAX_CONTEXT_CHARS to match.
DEVPILOT_OLLAMA_NUM_CTX=16384

# GitHub App (optional, read-only). Setup: docs/github-app.md
# Callback URL = the address you open the UI at + /api/github/oauth/callback
# (development: http://localhost:5173/api/github/oauth/callback; compose: http://localhost:8080/...)
DEVPILOT_GITHUB_CLIENT_ID=
DEVPILOT_GITHUB_CLIENT_SECRET=
# The App's URL name (github.com/apps/<slug>), used for the "choose repositories" link.
DEVPILOT_GITHUB_APP_SLUG=

# Limits
DEVPILOT_MAX_UPLOAD_BYTES=52428800
DEVPILOT_MAX_REPO_BYTES=209715200
DEVPILOT_MAX_FILE_BYTES=524288
DEVPILOT_REVIEWS_PER_HOUR=30
# Whole installation, all users together (stored in the database): new reviews per rolling hour.
DEVPILOT_REVIEWS_GLOBAL_PER_HOUR=60
DEVPILOT_RETENTION_DAYS=14
DEVPILOT_RUN_WORKER_IN_PROCESS=true
