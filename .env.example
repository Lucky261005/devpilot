# Copy to backend/.env for local development. Never commit the real .env.

# Database. SQLite works for local development; docker-compose uses PostgreSQL.
DEVPILOT_DATABASE_URL=sqlite:///./devpilot.db
# Where repository snapshots are stored.
DEVPILOT_DATA_DIR=./data
# Fernet key for encrypting GitHub tokens. REQUIRED when DEVPILOT_ENV != development.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DEVPILOT_SECRET_KEY=
DEVPILOT_ENV=development
# Set true when served over HTTPS.
DEVPILOT_COOKIE_SECURE=false
DEVPILOT_FRONTEND_ORIGIN=http://localhost:5173

# Local Git import is only allowed beneath these directories (";"-separated). Empty disables it.
DEVPILOT_ALLOWED_LOCAL_ROOTS=

# LLM review (optional). Without a provider, reviews run static analyzers only.
# anthropic (needs ANTHROPIC_API_KEY, paid) | ollama (local, free) | none
DEVPILOT_LLM_PROVIDER=anthropic
DEVPILOT_LLM_MAX_CONTEXT_CHARS=60000
DEVPILOT_LLM_TIMEOUT_S=120

# Anthropic
ANTHROPIC_API_KEY=
DEVPILOT_LLM_MODEL=claude-opus-5-5
DEVPILOT_LLM_EFFORT=medium

# Ollama (https://ollama.com). Keep it on 127.0.0.1; do not expose port 11434 publicly.
DEVPILOT_OLLAMA_URL=http://127.0.0.1:11434
DEVPILOT_OLLAMA_MODEL=qwen2.5-coder:3b
# Context window requested from Ollama. Prompts over ~75% of it are refused rather than truncated.
# 16384 tokens holds roughly 40000 characters of prompt; lower DEVPILOT_LLM_MAX_CONTEXT_CHARS to match.
DEVPILOT_OLLAMA_NUM_CTX=16384

# GitHub OAuth app (optional). Callback URL = the address you open the UI at + /api/github/oauth/callback
# (development: http://localhost:5173/api/github/oauth/callback; compose: http://localhost:8080/...)
DEVPILOT_GITHUB_CLIENT_ID=
DEVPILOT_GITHUB_CLIENT_SECRET=
# "" = public repositories, read-only. Use "repo" to allow private repositories.
DEVPILOT_GITHUB_OAUTH_SCOPES=

# Limits
DEVPILOT_MAX_UPLOAD_BYTES=52428800
DEVPILOT_MAX_REPO_BYTES=209715200
DEVPILOT_MAX_FILE_BYTES=524288
DEVPILOT_REVIEWS_PER_HOUR=30
DEVPILOT_RETENTION_DAYS=14
DEVPILOT_RUN_WORKER_IN_PROCESS=true
